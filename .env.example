# ---------- API ----------
NODE_ENV=development
API_PORT=4000
# Allowed browser origins. Leave EMPTY for LAN use: localhost and private
# network addresses (10.x, 192.168.x, 172.16-31.x) are then allowed on any
# port, so a changing machine IP never breaks the app. Set a comma-separated
# list to restrict it, or "*" to allow everything.
API_CORS_ORIGIN=

# PostgreSQL
DATABASE_URL=postgresql://mfd:mfd_dev_password@localhost:5432/mfd_tat?schema=public

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
JWT_REFRESH_EXPIRES_IN=7d

# Initial admin (created by seed script if no users exist)
ADMIN_EMAIL=admin@mfd.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME="MFD Admin"

# Candidate PII encryption (32-byte key, base64). Generate: openssl rand -base64 32
ENCRYPTION_KEY=

# ---------- AI provider ----------
# Which LLM powers parsing/scoring/generation: "anthropic" or "gemini".
# When unset, inferred from which API key below is present (Anthropic wins).
LLM_PROVIDER=

# Anthropic (LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Reasoning effort for AI calls: low | medium | high
ANTHROPIC_EFFORT=medium

# Google Gemini (LLM_PROVIDER=gemini)
GEMINI_API_KEY=
# Optional: pin a specific model. If the configured/default model is not
# available to your API key, the app auto-selects the best available Gemini
# model at first use and logs the choice.
GEMINI_MODEL=

# ---------- Email pre-screening (AWS SES SMTP) ----------
# 'simulated' (default when SMTP creds are missing): no email actually sent —
# the composed mail is stored on the conversation and the answer form works,
# so the flow is testable in-app. 'smtp': send for real via SES.
EMAIL_MODE=
# SES SMTP endpoint for your region, e.g. email-smtp.ap-south-1.amazonaws.com
SES_SMTP_HOST=
SES_SMTP_PORT=587
SES_SMTP_USER=
SES_SMTP_PASS=
# Must be a verified identity in SES
MAIL_FROM=hiring@metafordata.com
MAIL_FROM_NAME=MFD Talent
# Where candidate replies should go (defaults to MAIL_FROM)
MAIL_REPLY_TO=
# External answer form (e.g. a Google Form whose responses land in a Sheet).
# When set, pre-screening emails link HERE instead of the built-in form —
# use this while the app itself is not publicly reachable.
PRESCREEN_FORM_URL=https://forms.gle/ArPHA9cm3CDNdbgg7
# Public URL of the web app — used for the built-in answer-form links when
# PRESCREEN_FORM_URL is not set (must be candidate-reachable, not localhost)
WEB_PUBLIC_URL=http://localhost:3000

# ---------- WhatsApp pre-screening ----------
# 'simulated' (default): test the full conversation in-app, no WhatsApp account
# needed. 'meta': real WhatsApp via the Meta Cloud API (requires the values
# below from developers.facebook.com — see README).
WHATSAPP_MODE=simulated
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any random string; must match what you enter in the Meta webhook config
WHATSAPP_VERIFY_TOKEN=
# Meta app secret — enables webhook signature verification (recommended)
WHATSAPP_APP_SECRET=
# Name of your approved invite template (business-initiated first message).
# Body params: {{1}} candidate first name, {{2}} role title, {{3}} client name
WHATSAPP_TEMPLATE_INVITE=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v21.0

# S3-compatible storage (MinIO in docker-compose)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=mfd-minio
S3_SECRET_KEY=mfd-minio-secret
S3_BUCKET=mfd-documents
S3_FORCE_PATH_STYLE=true

# PDF export — path to a Chromium/Chrome binary (set in Docker image; auto-detected locally)
CHROMIUM_PATH=

# OCR fallback for scanned PDFs (requires tesseract binary; optional)
OCR_ENABLED=true

# Scoring weights (must sum to 100)
SCORE_WEIGHT_SKILLS=35
SCORE_WEIGHT_EXPERIENCE=25
SCORE_WEIGHT_KEYWORDS=20
SCORE_WEIGHT_EDUCATION=10
SCORE_WEIGHT_ATS=10

# ---------- Web ----------
# LEAVE THIS EMPTY for normal use, including team access over the LAN.
# The app calls the API on whatever address the browser used to open it
# (localhost:3000 -> localhost:4000, 10.0.0.5:3000 -> 10.0.0.5:4000), so it
# keeps working when this machine's IP changes — no rebuild needed.
#
# Set it only to pin a different API origin (separate API host, reverse proxy,
# custom domain). It is baked into the build, so changing it requires:
#   docker compose up -d --build web
NEXT_PUBLIC_API_URL=
